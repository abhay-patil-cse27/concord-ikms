# ==============================================================================
# CONCORD — Institutional Knowledge Management System
# Configuration Environment Template
# ==============================================================================

# Core Application Settings
APP_NAME="CONCORD - Institutional Knowledge Management System"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"

# Security & Authentication
# IMPORTANT: In production, generate a secure 64-char key using: openssl rand -hex 32
SECRET_KEY="concord-insecure-dev-secret-key-change-in-production-only"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Development Mode Helper: Allows instant one-click login as seeded roles (Platform Admin, Dept Admin, Faculty, Student)
# Set to false in production environments.
DEMO_MODE_ENABLED=true

# Database Configuration
# PostgreSQL connection string with asyncpg driver (Production / Docker):
DATABASE_URL="postgresql+asyncpg://concord_user:concord_password@localhost:5432/concord_db"
# Fallback local SQLite async connection (for lightweight dev/testing when PostgreSQL is not running):
# DATABASE_URL="sqlite+aiosqlite:///./concord_dev.db"

# Sync database URL for Alembic migrations (psycopg or sqlite driver)
DATABASE_SYNC_URL="postgresql+psycopg://concord_user:concord_password@localhost:5432/concord_db"
# DATABASE_SYNC_URL="sqlite:///./concord_dev.db"

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Future Module Placeholders (M2+)
OBJECT_STORAGE_BACKEND="local"
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="concord_minio"
S3_SECRET_KEY="concord_minio_secret"
S3_BUCKET_NAME="concord-documents"

# Groq Cloud LLM (Milestone 4 - Grounded RAG)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Optical Character Recognition (OCR) Engine (Optional path override)
# Windows default: "C:\Program Files\Tesseract-OCR\tesseract.exe"
# Linux default: "/usr/bin/tesseract"
TESSERACT_CMD=""
