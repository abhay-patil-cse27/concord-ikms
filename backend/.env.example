# ==============================================================================
# CONCORD — Environment Configuration Template (.env.example)
# ==============================================================================

# Database & Core
ENVIRONMENT=development
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-32-char-string
DATABASE_URL=sqlite:///./concord_dev.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Optional: regex for dynamic tunnel origins (Cloudflare / Ngrok)
# CORS_ORIGIN_REGEX=https://.*trycloudflare\.com

# Dual-Mode LLM Engine (Milestone 11)
LLM_PROVIDER_MODE=cloud
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:1.5b
LOCAL_LLM_TIMEOUT_SECONDS=60.0

# Cloud Groq LLM (Required if LLM_PROVIDER_MODE=cloud)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma
